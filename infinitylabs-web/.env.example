# Canonical site origin (metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://infinitylabscol.com

# Contact form delivery — configure ONE of the options below.
# Option A: generic webhook (CRM, n8n, Make, Zapier, Slack…)
# CONTACT_WEBHOOK_URL=https://example.com/hooks/contact

# Option B: email via Resend HTTP API
# RESEND_API_KEY=re_xxx
# CONTACT_TO=info@infinitylabscol.com
# CONTACT_FROM="Infinity Labs Website <no-reply@infinitylabscol.com>"

# Analytics adapter: gtag | plausible | datalayer (unset = no tracking)
# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
